---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getDb } from "../../lib/db";
import { notifications } from "../../db/schema";
import { eq, desc } from "drizzle-orm";

const user = Astro.locals.user;
if (!user || user.userType !== "admin") {
  return Astro.redirect("/login");
}

const db = getDb();

// Fetch notifications for admin (strictly platform applications only)
const rawNotifications = await db
  .select()
  .from(notifications)
  .where(eq(notifications.userId, user.userId))
  .orderBy(desc(notifications.createdAt));

const userNotifications = rawNotifications.filter(n =>
  !n.title?.includes('External Application') &&
  !n.message?.includes('external application') &&
  !n.message?.includes('Submitted via Alightway')
);
---

<DashboardLayout title="Notifications | Admin" userType="admin" activePath="/admin/notifications">
  <div class="dashboard-header">
    <div class="header-content">
      <div class="title-with-icon">
        <div class="header-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
        </div>
        <div>
          <h1>Notifications {userNotifications.filter(n => !n.isRead).length > 0 && <span id="pageUnreadCount" class="badge bg-primary text-white" style="font-size: 0.9rem; padding: 2px 8px; border-radius: 12px; margin-left: 8px;">{userNotifications.filter(n => !n.isRead).length}</span>}</h1>
          <p class="text-muted" style="margin: 0; font-size: 0.875rem;">View and manage your alerts.</p>
        </div>
      </div>
      {userNotifications.some(n => !n.isRead) && (
        <button type="button" class="btn btn-outline btn-sm" id="markAllReadBtn" onclick="markAllAsRead()">Mark All as Read</button>
      )}
    </div>
  </div>

  <div class="admin-content-grid">
    <div class="notifications-container">
      {userNotifications.length === 0 ? (
        <div class="empty-state">
          <span class="icon bell-icon" style="font-size: 3rem; margin-bottom: 1rem; color: var(--color-text-muted);"></span>
          <h3>No notifications yet</h3>
          <p>You're all caught up!</p>
        </div>
      ) : (
        <div class="notification-list">
          {userNotifications.map((notif) => (
            <div class={`notification-card ${notif.isRead ? 'read' : 'unread'}`} data-id={notif.id}>
              <div class="notif-content">
                <div class="notif-header">
                  <h4>{notif.title}</h4>
                  <span class="time">{notif.createdAt ? new Date(notif.createdAt).toLocaleString() : 'Just now'}</span>
                </div>
                <p>{notif.message}</p>
              </div>
              {!notif.isRead && (
                <button type="button" class="btn-mark-read" onclick={`markAsRead('${notif.id}')`}>Mark as Read</button>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</DashboardLayout>

<script is:inline>
  async function markAsRead(notificationId) {
    try {
      const res = await fetch('/api/notifications/read', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ notificationId })
      });
      
      if (res.ok) {
        const card = document.querySelector(`.notification-card[data-id="${notificationId}"]`);
        if (card) {
          card.classList.remove('unread');
          card.classList.add('read');
          const btn = card.querySelector('.btn-mark-read');
          if (btn) btn.remove();
        }
        if (typeof window.decrementNotificationBadge === 'function') {
          window.decrementNotificationBadge(1);
        }

        const pageCount = document.getElementById('pageUnreadCount');
        if (pageCount) {
          let current = parseInt(pageCount.textContent, 10) || 0;
          current = Math.max(0, current - 1);
          if (current === 0) {
            pageCount.style.display = 'none';
          } else {
            pageCount.textContent = current;
          }
        }

        if (!document.querySelector('.notification-card.unread')) {
          const markAllBtn = document.getElementById('markAllReadBtn');
          if (markAllBtn) markAllBtn.remove();
        }
      }
    } catch (err) {
      console.error(err);
    }
  }

  async function markAllAsRead() {
    const markAllBtn = document.getElementById('markAllReadBtn');
    if (markAllBtn) markAllBtn.disabled = true;

    try {
      const res = await fetch('/api/notifications/read', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ all: true })
      });
      if (res.ok) {
        document.querySelectorAll('.notification-card.unread').forEach(card => {
          card.classList.remove('unread');
          card.classList.add('read');
          const btn = card.querySelector('.btn-mark-read');
          if (btn) btn.remove();
        });
        if (markAllBtn) markAllBtn.remove();
        const pageCount = document.getElementById('pageUnreadCount');
        if (pageCount) pageCount.style.display = 'none';
        if (typeof window.clearNotificationBadge === 'function') {
          window.clearNotificationBadge();
        }
        const topbarBadge = document.getElementById('topbarNotificationBadge');
        if (topbarBadge) topbarBadge.remove();
      }
    } catch (err) {
      console.error('Failed to mark all notifications as read:', err);
    } finally {
      if (markAllBtn) markAllBtn.disabled = false;
    }
  }
</script>

<style>
  .dashboard-header {
    margin-bottom: 2rem;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .title-with-icon {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-icon-box {
    width: 48px;
    height: 48px;
    border-radius: var(--border-radius-md);
    background: rgba(124, 58, 237, 0.12);
    border: 1px solid rgba(124, 58, 237, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .title-with-icon h1 {
    font-size: 1.75rem;
    color: var(--color-text-main);
    margin: 0;
  }

  .admin-content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .notifications-container {
    max-width: 800px;
  }

  .notification-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .notification-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    transition: all 0.2s;
  }

  .notification-card.unread {
    border-left: 4px solid var(--color-primary);
    background: var(--color-bg);
  }

  .notif-content {
    flex: 1;
  }

  .notif-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .notif-header h4 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-text-main);
  }

  .time {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .notification-card p {
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .btn-mark-read {
    background: var(--color-bg);
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    padding: 0.5rem 1rem;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    font-weight: 500;
    font-size: 0.875rem;
    transition: all 0.2s;
  }

  .btn-mark-read:hover {
    background: var(--color-primary);
    color: white;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--color-surface);
    border-radius: var(--border-radius-lg);
    border: 1px dashed var(--color-border);
  }

  @media (max-width: 640px) {
    .header-content {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 1rem !important;
    }
    .header-content button {
      width: 100% !important;
      justify-content: center !important;
      text-align: center !important;
    }
    .notification-card {
      flex-direction: column !important;
      align-items: flex-start !important;
      padding: 1.15rem 1rem !important;
      gap: 0.85rem !important;
    }
    .notif-header {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 0.25rem !important;
    }
    .btn-mark-read {
      width: 100% !important;
      text-align: center !important;
    }
  }
</style>
