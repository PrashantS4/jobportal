---
import Layout from '../layouts/Layout.astro';
import { getDb } from '../lib/db';
import { plans } from '../db/schema';
import { eq } from 'drizzle-orm';

// @ts-ignore
const user = Astro.locals?.user;

const db = getDb();
const dbPlans = await db.select().from(plans).where(eq(plans.isActive, true));

const p001 = dbPlans.find(p => p.planId === 'P001') || { planName: 'Basic Plan', price: 0, currency: 'USD', jobPostingLimit: 30, resumeLimit: 500, candidateApplyLimit: 200 };
const p002 = dbPlans.find(p => p.planId === 'P002') || { planName: 'Growth Plan', price: 0, currency: 'USD', jobPostingLimit: 60, resumeLimit: 3000, candidateApplyLimit: 450 };
const p003 = dbPlans.find(p => p.planId === 'P003') || { planName: 'Premium Plan', price: 0, currency: 'USD', jobPostingLimit: 999999, resumeLimit: 999999, candidateApplyLimit: 999999 };

const formatPrice = (price: number, currency: string) => {
  if (!price || price <= 0) return 'Free';
  const symbol = currency === 'INR' ? '₹' : '$';
  return `${symbol}${price}`;
};

const formatLimit = (limit: number) => {
  return limit >= 999999 ? 'Unlimited' : limit.toLocaleString();
};
---

<Layout
  title="Pricing & Subscription Plans - RecruitNest"
  description="Transparent hiring and recruitment pricing plans for startups, growing tech teams, and enterprises. Start free today with RecruitNest."
  keywords="recruitment pricing, hiring plan subscription, ATS pricing, candidate matching software cost"
  schemaType="SoftwareApplication"
>
  <!-- Navigation Header (Consistent with Landing Page) -->
  <header class="landing-nav">
    <div class="nav-container">
      <div class="logo">
        <a href="/" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: inherit;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="logo-icon">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
          <span style="font-weight: 800; font-size: 1.25rem;">RecruitNest</span>
        </a>
      </div>
      <nav class="nav-links">
        <a href="/">Home</a>
        <a href="/pricing" class="active">Pricing</a>
        <a href="/about">About</a>
      </nav>
      <div class="nav-actions">
        <button type="button" class="theme-toggle-btn" aria-label="Toggle Light/Dark Theme" title="Toggle Light/Dark Theme">
          <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
        {user ? (
          <a href={user.userType === 'employer' ? '/employer' : '/dashboard'} class="btn btn-primary">Dashboard</a>
        ) : (
          <>
            <a href="/login" class="btn btn-outline">Log in</a>
            <a href="/register" class="btn btn-primary">Sign up</a>
          </>
        )}
      </div>
    </div>
  </header>

  <main class="pricing-container" id="pricing">
    <div class="pricing-header">
      <div class="badge">
        <span class="dot"></span> Subscription Plans
      </div>
      <h1>Simple, Transparent Pricing</h1>
      <p class="subtitle">Select the perfect tier to match your hiring needs. Switch or upgrade anytime with instant account limit updates.</p>
    </div>

    <div class="pricing-grid">
      
      <!-- Basic Plan -->
      <div class="pricing-card">
        <div class="card-header-block">
          <span class="plan-tag">Starter Tier</span>
          <h3 class="plan-name">{p001.planName}</h3>
          <div class="price-row">
            <span class="price-val">{formatPrice(p001.price, p001.currency)}</span>
            <span class="price-sub">{p001.price > 0 ? '/ month' : '/ forever'}</span>
          </div>
          <p class="plan-desc">For job seekers & early startups posting initial hiring needs.</p>
        </div>

        <div class="card-body-block">
          <ul class="feature-list">
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>{formatLimit(p001.jobPostingLimit)} Active Job Postings</strong></span>
            </li>
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>{formatLimit(p001.resumeLimit)} Resumes Received</strong> Limit</span>
            </li>
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>{formatLimit(p001.candidateApplyLimit)} Monthly Job Applications</strong></span>
            </li>
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Basic AI Resume Match Scoring</span>
            </li>
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Application Status Tracking & Saved Jobs</span>
            </li>
          </ul>

          <div class="card-action">
            {user ? (
              <button class="btn btn-outline w-full rzp-button" data-plan="P001">Select Basic Plan</button>
            ) : (
              <a href="/register?plan=P001" class="btn btn-outline w-full">Sign Up Free</a>
            )}
          </div>
        </div>
      </div>

      <!-- Growth Plan -->
      <div class="pricing-card popular">
        <div class="popular-pill">MOST POPULAR</div>

        <div class="card-header-block">
          <span class="plan-tag popular-tag">Scaling Tech Teams</span>
          <h3 class="plan-name">{p002.planName}</h3>
          <div class="price-row">
            <span class="price-val">{formatPrice(p002.price, p002.currency)}</span>
            <span class="price-sub">{p002.price > 0 ? '/ month' : '/ full access'}</span>
          </div>
          <p class="plan-desc">For active companies requiring higher capacity & rich job tools.</p>
        </div>

        <div class="card-body-block">
          <ul class="feature-list">
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>{formatLimit(p002.jobPostingLimit)} Active Job Postings</strong></span>
            </li>
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>{formatLimit(p002.resumeLimit)} Resumes Received</strong> Limit</span>
            </li>
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>{formatLimit(p002.candidateApplyLimit)} Monthly Job Applications</strong></span>
            </li>
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>AI Vector Resume Search & Match Scoring</span>
            </li>
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Custom Candidate Screening Questionnaires</span>
            </li>
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>CKEditor Rich Text Job Description Editor</span>
            </li>
          </ul>

          <div class="card-action">
            {user ? (
              <button class="btn btn-primary w-full rzp-button" data-plan="P002">Select Growth Plan</button>
            ) : (
              <a href="/register?plan=P002" class="btn btn-primary w-full">Sign Up Free</a>
            )}
          </div>
        </div>
      </div>

      <!-- Premium Plan -->
      <div class="pricing-card">
        <div class="card-header-block">
          <span class="plan-tag">Enterprise Tier</span>
          <h3 class="plan-name">{p003.planName}</h3>
          <div class="price-row">
            <span class="price-val">{formatPrice(p003.price, p003.currency)}</span>
            <span class="price-sub">{p003.price > 0 ? '/ month' : '/ unlimited volume'}</span>
          </div>
          <p class="plan-desc">For large teams needing maximum volume & full platform access.</p>
        </div>

        <div class="card-body-block">
          <ul class="feature-list">
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>{formatLimit(p003.jobPostingLimit)} Active Job Postings</strong></span>
            </li>
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>{formatLimit(p003.resumeLimit)} Resumes Received</strong></span>
            </li>
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>{formatLimit(p003.candidateApplyLimit)} Monthly Job Applications</strong></span>
            </li>
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Full AI Candidate Match & Vector Search</span>
            </li>
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Employer Candidate Review & Resume Download</span>
            </li>
            <li>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Custom Screening Questions & Pipeline Tracking</span>
            </li>
          </ul>

          <div class="card-action">
            {user ? (
              <button class="btn btn-outline w-full rzp-button" data-plan="P003">Select Premium Plan</button>
            ) : (
              <a href="/register?plan=P003" class="btn btn-outline w-full">Sign Up Free</a>
            )}
          </div>
        </div>
      </div>

    </div>

    <div class="login-prompt">
      <p>Already have an account? <a href="/login" class="text-primary fw-600">Log in to dashboard</a></p>
    </div>
  </main>

  <script define:vars={{ userType: user?.userType || 'employee' }}>
    document.querySelectorAll('.rzp-button').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const planId = e.target.getAttribute('data-plan');
        const oldText = e.target.innerText;
        e.target.innerText = 'Activating...';
        e.target.disabled = true;

        try {
          const verifyRes = await fetch('/api/payments/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              planId,
              billingCycle: 'monthly'
            })
          });

          if (verifyRes.ok) {
            alert('Plan activated successfully!');
            window.location.href = userType === 'employer' ? '/employer' : '/dashboard';
          } else {
            alert('Failed to activate plan.');
          }
        } catch (err) {
          console.error(err);
          alert('An error occurred during activation.');
        } finally {
          e.target.innerText = oldText;
          e.target.disabled = false;
        }
      });
    });
  </script>
</Layout>

<style>
  .landing-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    padding: 0.85rem 0;
  }
  :global([data-theme="light"]) .landing-nav {
    background: rgba(255, 255, 255, 0.85);
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-links {
    display: flex;
    gap: 1.75rem;
  }
  .nav-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: var(--color-primary);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pricing-container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 5rem 1.5rem;
  }

  .pricing-header {
    text-align: center;
    margin-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    background-color: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    color: var(--color-primary);
  }

  .dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-primary);
    border-radius: 50%;
  }

  .pricing-header h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: var(--color-text-main);
    letter-spacing: -0.03em;
  }

  .pricing-header .subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 620px;
    line-height: 1.6;
  }

  /* Perfectly Balanced Modern Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    align-items: stretch;
    margin-bottom: 3rem;
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 2.25rem 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .pricing-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 32px rgba(16, 185, 129, 0.12);
    border-color: var(--color-primary);
  }

  .pricing-card.popular {
    border: 2px solid var(--color-primary);
    box-shadow: 0 12px 30px rgba(16, 185, 129, 0.18);
    background: linear-gradient(180deg, rgba(16, 185, 129, 0.04) 0%, var(--color-surface) 100%);
  }

  .popular-pill {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #10B981, #6366F1);
    color: white;
    padding: 0.3rem 1.1rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
  }

  .card-header-block {
    text-align: center;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.5rem;
  }

  .plan-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }

  .plan-tag.popular-tag {
    color: var(--color-primary);
  }

  .plan-name {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text-main);
    margin-bottom: 0.75rem;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.3rem;
    margin-bottom: 0.65rem;
  }

  .price-val {
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-text-main);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .price-sub {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .plan-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
    min-height: 2.6rem;
  }

  .card-body-block {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .feature-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .feature-list li strong {
    color: var(--color-text-main);
  }

  .check-icon {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .card-action {
    margin-top: auto;
  }

  .w-full {
    width: 100%;
    text-align: center;
    justify-content: center;
    padding: 0.75rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: 12px;
  }

  .login-prompt {
    text-align: center;
    margin-top: 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .fw-600 {
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  .fw-600:hover {
    text-decoration: underline;
  }

  /* Responsive Adjustments */
  @media (max-width: 992px) {
    .pricing-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 460px;
      margin-left: auto;
      margin-right: auto;
    }
    .pricing-header h1 {
      font-size: 2rem;
    }
    .plan-desc {
      min-height: auto;
    }
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
    .pricing-container {
      padding: 2rem 1rem 4rem 1rem;
    }
  }
</style>
