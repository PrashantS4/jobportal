---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getDb } from '../../../../lib/db';
import { users, jobPostings, plans } from '../../../../db/schema';
import { eq, desc } from 'drizzle-orm';

const payload = Astro.locals.user;
if (!payload || (payload.userType !== 'masteradmin' && payload.userType !== 'superadmin')) {
  return Astro.redirect('/login');
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/masteradmin/employers');
}

const db = getDb();

const employer = await db.select().from(users).where(eq(users.id, id)).get();
if (!employer || employer.userType !== 'employer') {
  return Astro.redirect('/masteradmin/employers');
}

const allPlans = await db.select().from(plans).all();
const employerJobs = await db.select().from(jobPostings).where(eq(jobPostings.employerId, employer.id)).orderBy(desc(jobPostings.createdAt)).all();
const totalJobs = employerJobs.length;
---

<DashboardLayout title={`Edit Employer: ${employer.companyName || employer.firstName}`} userType="masteradmin" activePath="/masteradmin/employers">
  <div class="dashboard-header mb-4">
    <div class="back-link-wrap mb-3">
      <a href="/masteradmin/employers" class="back-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to Employer Directory
      </a>
    </div>
    <div class="header-titles">
      <span class="badge-tag">MasterAdmin Management</span>
      <h1>Edit Employer Profile: {employer.companyName || `${employer.firstName} ${employer.lastName}`}</h1>
      <p class="subtitle">Update company details, subscription plan, verification status, and account standing.</p>
    </div>
  </div>

  <div class="admin-edit-grid">
    <div class="edit-main-col">
      <form id="admin-edit-employer-form" class="card form-card">
        <input type="hidden" name="userId" value={employer.id} />
        
        <!-- Account Status Section -->
        <div class="form-section">
          <div class="section-title-row">
            <h3>Account Standing & Verification</h3>
            <span class="user-id-pill">ID: {employer.id}</span>
          </div>

          <div class="form-grid mt-3">
            <div class="form-group">
              <label for="isActive">Account Status <span class="req">*</span></label>
              <select id="isActive" name="isActive">
                <option value="true" selected={employer.isActive === true}>🟢 Active Account (Can post jobs & manage applications)</option>
                <option value="false" selected={employer.isActive === false}>🔴 Suspended / Blocked (Cannot post jobs)</option>
              </select>
            </div>

            <div class="form-group">
              <label for="verifiedStatus">Corporate Verification <span class="req">*</span></label>
              <select id="verifiedStatus" name="verifiedStatus">
                <option value="verified" selected={employer.verifiedStatus === 'verified'}>✓ Verified Employer</option>
                <option value="pending" selected={employer.verifiedStatus === 'pending'}>⏳ Pending Verification</option>
                <option value="rejected" selected={employer.verifiedStatus === 'rejected'}>✕ Rejected Employer</option>
              </select>
            </div>
          </div>

          <div class="form-grid mt-3">
            <div class="form-group full-width">
              <label for="planId">Assigned Subscription Plan</label>
              <select id="planId" name="planId">
                <option value="" selected={!employer.planId}>No Active Plan (Free Tier)</option>
                {allPlans.map(p => (
                  <option value={p.planId} selected={employer.planId === p.planId}>
                    {p.planName} ({p.planId}) — ${p.price}/mo ({p.jobPostingLimit} Jobs limit)
                  </option>
                ))}
              </select>
            </div>
          </div>
        </div>

        <div class="form-divider"></div>

        <!-- Contact Recruiter Details -->
        <div class="form-section">
          <h3>Primary Contact Recruiter</h3>

          <div class="form-grid mt-3">
            <div class="form-group">
              <label for="firstName">First Name <span class="req">*</span></label>
              <input type="text" id="firstName" name="firstName" required value={employer.firstName} />
            </div>
            <div class="form-group">
              <label for="lastName">Last Name <span class="req">*</span></label>
              <input type="text" id="lastName" name="lastName" required value={employer.lastName} />
            </div>
          </div>

          <div class="form-grid mt-3">
            <div class="form-group">
              <label for="email">Email Address (Read-only)</label>
              <input type="email" id="email" value={employer.email} disabled class="disabled-input" />
            </div>
            <div class="form-group">
              <label for="phone">Contact Phone</label>
              <input type="tel" id="phone" name="phone" value={employer.phone || ''} placeholder="+1 (555) 000-0000" />
            </div>
          </div>
        </div>

        <div class="form-divider"></div>

        <!-- Company Information -->
        <div class="form-section">
          <h3>Company Information</h3>

          <div class="form-grid mt-3">
            <div class="form-group">
              <label for="companyName">Company Name</label>
              <input type="text" id="companyName" name="companyName" value={employer.companyName || ''} placeholder="e.g. Acme Corporation" />
            </div>
            <div class="form-group">
              <label for="companyWebsite">Company Website URL</label>
              <input type="url" id="companyWebsite" name="companyWebsite" value={employer.companyWebsite || ''} placeholder="https://company.com" />
            </div>
          </div>

          <div class="form-grid mt-3">
            <div class="form-group">
              <label for="companyIndustry">Industry / Field</label>
              <input type="text" id="companyIndustry" name="companyIndustry" value={employer.companyIndustry || ''} placeholder="e.g. Software & Technology" />
            </div>
            <div class="form-group">
              <label for="companySize">Company Size</label>
              <select id="companySize" name="companySize">
                <option value="" selected={!employer.companySize}>Select size...</option>
                <option value="1-10 employees" selected={employer.companySize === '1-10 employees'}>1-10 employees</option>
                <option value="11-50 employees" selected={employer.companySize === '11-50 employees'}>11-50 employees</option>
                <option value="51-200 employees" selected={employer.companySize === '51-200 employees'}>51-200 employees</option>
                <option value="201-500 employees" selected={employer.companySize === '201-500 employees'}>201-500 employees</option>
                <option value="500+ employees" selected={employer.companySize === '500+ employees'}>500+ employees</option>
              </select>
            </div>
          </div>

          <div class="form-group full-width mt-3">
            <label for="companyBio">Company Overview & Bio</label>
            <textarea id="companyBio" name="companyBio" rows="4" placeholder="Brief summary of company vision, product, culture...">{employer.companyBio || ''}</textarea>
          </div>
        </div>

        <div class="form-divider"></div>

        <!-- Admin Password Reset -->
        <div class="form-section">
          <h3>🔐 Admin Password Reset</h3>
          <p class="sec-subtitle">Force reset the password for this employer account.</p>
          <div class="form-grid mt-3">
            <div class="form-group">
              <label for="newPasswordInput">New Password</label>
              <input type="password" id="newPasswordInput" placeholder="Enter at least 6 characters" minlength="6" />
            </div>
            <div class="form-group align-end">
              <button type="button" class="btn btn-warning" id="admin-reset-pwd-btn">
                🔑 Reset Account Password
              </button>
            </div>
          </div>
        </div>

        <div class="form-actions-bar mt-4">
          <a href="/masteradmin/employers" class="btn btn-outline">Cancel</a>
          <button type="submit" class="btn btn-primary btn-glow" id="save-employer-btn">
            Save & Update Employer Profile
          </button>
        </div>
      </form>

      <!-- Employer Jobs List Section -->
      <div class="card mt-4" style="padding: 1.75rem; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface);">
        <div class="section-title-row mb-2">
          <h3>Employer Job Postings</h3>
          <span class="badge-tag">{employerJobs.length} Total Jobs</span>
        </div>
        <p class="sec-subtitle mb-3">A complete list of all active, draft, closed, and deleted job postings by this employer.</p>
        
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Job Title</th>
                <th>Status</th>
                <th>Applications</th>
                <th>Posted Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {employerJobs.length === 0 ? (
                <tr>
                  <td colspan="5" style="text-align: center; color: var(--color-text-muted); padding: 3rem;">No jobs posted yet.</td>
                </tr>
              ) : (
                employerJobs.map((job) => (
                  <tr class="data-row">
                    <td>
                      <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                        <strong style="color: var(--color-text-main); font-size: 0.95rem;">{job.jobTitle}</strong>
                        {job.isDeleted && <span style="font-size: 0.65rem; background: rgba(239, 68, 68, 0.15); color: #ef4444; padding: 0.15rem 0.4rem; border-radius: 4px; font-weight: 700;">Deleted</span>}
                      </div>
                      <div style="font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.25rem;">
                        📍 {job.locationCity || (job.locationRemote ? 'Remote' : 'Onsite')} • ⏱ {job.employmentType || 'Full-time'}
                      </div>
                    </td>
                    <td>
                      <span class={`status-badge status-${job.status}`}>
                        {job.status.charAt(0).toUpperCase() + job.status.slice(1)}
                      </span>
                    </td>
                    <td>
                      <strong style="color: var(--color-primary); font-size: 0.9rem;">{job.applicationsCount || 0} Apps</strong>
                    </td>
                    <td>
                      <span class="date-text">
                        {job.createdAt ? new Date(job.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '-'}
                      </span>
                    </td>
                    <td>
                      <a href={`/jobs/${job.id}`} class="view-dash-btn" title="View Job Details">
                        👁️ View
                      </a>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Employer Sidebar -->
    <div class="edit-sidebar-col">
      <div class="card sidebar-card">
        <h3>Employer Overview</h3>
        <div class="user-summary-box">
          <div class="user-avatar-lg">
            {(employer.companyName || employer.firstName).charAt(0).toUpperCase()}
          </div>
          <div>
            <strong>{employer.companyName || 'Company'}</strong>
            <p>{employer.firstName} {employer.lastName}</p>
            <span class="user-email-txt">{employer.email}</span>
          </div>
        </div>

        <div class="sidebar-divider"></div>

        <div class="meta-item-row">
          <span class="meta-lbl">Joined Date</span>
          <span class="meta-val">{employer.createdAt ? new Date(employer.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—'}</span>
        </div>
        <div class="meta-item-row">
          <span class="meta-lbl">Active Job Posts</span>
          <span class="meta-val highlight">{totalJobs}</span>
        </div>

        <div class="sidebar-divider"></div>

        <h3>Danger Zone</h3>
        <p class="sec-text">Permanently delete this employer account and remove all posted jobs.</p>
        <button type="button" class="btn btn-danger w-full mt-2" id="delete-employer-btn">
          🗑️ Delete Employer Account
        </button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  const form = document.getElementById('admin-edit-employer-form') as HTMLFormElement | null;
  const saveBtn = document.getElementById('save-employer-btn') as HTMLButtonElement | null;
  const deleteBtn = document.getElementById('delete-employer-btn') as HTMLButtonElement | null;
  const resetPwdBtn = document.getElementById('admin-reset-pwd-btn') as HTMLButtonElement | null;
  const newPasswordInput = document.getElementById('newPasswordInput') as HTMLInputElement | null;

  if (form && saveBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data: Record<string, any> = Object.fromEntries(formData.entries());

      const originalText = saveBtn.innerText;
      saveBtn.innerText = 'Saving Changes...';
      saveBtn.disabled = true;

      try {
        const res = await fetch('/api/admin/users/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(data)
        });

        const result = await res.json();

        if (res.ok) {
          // @ts-ignore
          if (window.showToast) window.showToast('Employer profile updated successfully!');
          setTimeout(() => {
            window.location.href = '/masteradmin/employers';
          }, 800);
        } else {
          // @ts-ignore
          if (window.showToast) window.showToast(result.error || 'Failed to update employer', 'error');
          saveBtn.innerText = originalText;
          saveBtn.disabled = false;
        }
      } catch (err) {
        // @ts-ignore
        if (window.showToast) window.showToast('An error occurred while saving.', 'error');
        saveBtn.innerText = originalText;
        saveBtn.disabled = false;
      }
    });
  }

  if (resetPwdBtn && newPasswordInput) {
    resetPwdBtn.addEventListener('click', async () => {
      const newPassword = newPasswordInput.value.trim();
      const userId = (document.querySelector('input[name="userId"]') as HTMLInputElement)?.value;

      if (!newPassword || newPassword.length < 6) {
        // @ts-ignore
        if (window.showToast) window.showToast('Please enter a new password of at least 6 characters.', 'error');
        return;
      }

      resetPwdBtn.innerText = 'Resetting...';
      resetPwdBtn.disabled = true;

      try {
        const res = await fetch('/api/admin/users/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ userId, newPassword })
        });

        const result = await res.json();
        if (res.ok) {
          // @ts-ignore
          if (window.showToast) window.showToast('Password reset successfully!');
          newPasswordInput.value = '';
        } else {
          // @ts-ignore
          if (window.showToast) window.showToast(result.error || 'Failed to reset password', 'error');
        }
      } catch (err) {
        // @ts-ignore
        if (window.showToast) window.showToast('Error resetting password.', 'error');
      } finally {
        resetPwdBtn.innerText = '🔑 Reset Account Password';
        resetPwdBtn.disabled = false;
      }
    });
  }

  if (deleteBtn) {
    deleteBtn.addEventListener('click', async () => {
      const confirmDelete = confirm('Are you sure you want to PERMANENTLY delete this employer account? All posted jobs will be deleted.');
      if (!confirmDelete) return;

      const userId = (document.querySelector('input[name="userId"]') as HTMLInputElement)?.value;
      if (!userId) return;

      deleteBtn.innerText = 'Deleting...';
      deleteBtn.disabled = true;

      try {
        const res = await fetch('/api/admin/users/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ userId })
        });

        if (res.ok) {
          // @ts-ignore
          if (window.showToast) window.showToast('Employer deleted successfully.');
          window.location.href = '/masteradmin/employers';
        } else {
          const result = await res.json();
          // @ts-ignore
          if (window.showToast) window.showToast(result.error || 'Failed to delete employer', 'error');
          deleteBtn.innerText = '🗑️ Delete Employer Account';
          deleteBtn.disabled = false;
        }
      } catch (err) {
        // @ts-ignore
        if (window.showToast) window.showToast('An error occurred during deletion.', 'error');
        deleteBtn.innerText = '🗑️ Delete Employer Account';
        deleteBtn.disabled = false;
      }
    });
  }
</script>

<style>
  .mb-4 { margin-bottom: 1.75rem; }
  .mb-3 { margin-bottom: 1rem; }
  .mt-3 { margin-top: 1rem; }
  .mt-4 { margin-top: 1.5rem; }
  .mt-2 { margin-top: 0.5rem; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }
  .back-link:hover { text-decoration: underline; }

  .badge-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(168, 85, 247, 0.15);
    color: #a855f7;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .header-titles h1 {
    margin: 0 0 0.3rem 0;
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .subtitle {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .admin-edit-grid {
    display: grid;
    grid-template-columns: 2.5fr 1fr;
    gap: 1.5rem;
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .edit-main-col, .edit-sidebar-col {
    min-width: 0;
    max-width: 100%;
  }

  .form-card {
    padding: 2rem;
    box-sizing: border-box;
    max-width: 100%;
    overflow: hidden;
  }

  .form-section h3 {
    margin: 0 0 0.2rem 0;
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .sec-subtitle {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 100%;
  }

  .user-id-pill {
    font-size: 0.75rem;
    font-weight: 700;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    color: var(--color-text-muted);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    min-width: 0;
    max-width: 100%;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
    max-width: 100%;
  }

  .form-group.full-width {
    grid-column: 1 / -1;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .req { color: #ef4444; }

  .form-group input, .form-group select, .form-group textarea {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 0.75rem 1rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-text-main);
    font-size: 0.92rem;
    outline: none;
    font-family: inherit;
    text-overflow: ellipsis;
  }

  .disabled-input {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .align-end {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
  }

  .btn-warning {
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.3);
    font-weight: 700;
    padding: 0.75rem 1.25rem;
    border-radius: 10px;
    cursor: pointer;
    max-width: 100%;
    box-sizing: border-box;
  }

  .form-divider {
    height: 1px;
    background: var(--color-border);
    margin: 1.75rem 0;
  }

  .form-actions-bar {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    max-width: 100%;
    flex-wrap: wrap;
  }

  .sidebar-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-sizing: border-box;
    max-width: 100%;
  }

  .sidebar-card h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .user-summary-box {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    min-width: 0;
  }

  .user-avatar-lg {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: linear-gradient(135deg, #a855f7, #6366f1);
    color: white;
    font-size: 1.4rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .user-summary-box strong {
    display: block;
    color: var(--color-text-main);
    font-size: 1rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .user-summary-box p {
    margin: 0.1rem 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .user-email-txt {
    font-size: 0.78rem;
    color: #a855f7;
    word-break: break-all;
  }

  .sidebar-divider {
    height: 1px;
    background: var(--color-border);
  }

  .meta-item-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
  }
  .meta-lbl { color: var(--color-text-muted); }
  .meta-val { font-weight: 700; color: var(--color-text-main); }
  .meta-val.highlight { color: #a855f7; font-size: 1rem; }

  .sec-text {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .w-full { width: 100%; }

  @media (max-width: 1024px) {
    .admin-edit-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .form-grid { grid-template-columns: 1fr !important; }
    .form-card { padding: 1.25rem !important; }
    .section-title-row { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .form-actions-bar { flex-direction: column; width: 100%; }
    .form-actions-bar .btn { width: 100%; text-align: center; justify-content: center; box-sizing: border-box; }
    .align-end { justify-content: flex-start; width: 100%; }
    .align-end button { width: 100%; }
  }

  /* Job Postings Table CSS */
  .table-responsive {
    overflow-x: auto;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    margin-top: 1rem;
    background: var(--color-bg);
  }

  .data-table {
    width: 100%;
    min-width: 600px;
    border-collapse: collapse;
    text-align: left;
  }

  .data-table th {
    padding: 1rem 1.25rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--color-border);
    background: rgba(0,0,0,0.02);
    white-space: nowrap;
  }

  .data-table td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
