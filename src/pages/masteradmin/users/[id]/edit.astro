---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getDb } from '../../../../lib/db';
import { users, applications, plans } from '../../../../db/schema';
import { eq, count } from 'drizzle-orm';

const payload = Astro.locals.user;
if (!payload || (payload.userType !== 'masteradmin' && payload.userType !== 'superadmin')) {
  return Astro.redirect('/login');
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/masteradmin/users');
}

const db = getDb();
const candidate = await db.select().from(users).where(eq(users.id, id)).get();

if (!candidate || candidate.userType !== 'employee') {
  return Astro.redirect('/masteradmin/users');
}

const appCountResult = await db.select({ count: count() }).from(applications).where(eq(applications.applicantId, candidate.id));
const totalApplications = appCountResult[0]?.count || 0;

const allPlans = await db.select().from(plans).all();

let skillsText = '';
if (candidate.skills) {
  try {
    const parsed = typeof candidate.skills === 'string' ? JSON.parse(candidate.skills) : candidate.skills;
    if (Array.isArray(parsed)) skillsText = parsed.join(', ');
  } catch (e) {
    skillsText = String(candidate.skills);
  }
}
---

<DashboardLayout title={`Edit Candidate: ${candidate.firstName} ${candidate.lastName}`} userType="masteradmin" activePath="/masteradmin/users">
  <div class="dashboard-header mb-4">
    <div class="back-link-wrap mb-3">
      <a href="/masteradmin/users" class="back-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to Candidate Directory
      </a>
    </div>
    <div class="header-titles">
      <span class="badge-tag">MasterAdmin Management</span>
      <h1>Edit Candidate Profile: {candidate.firstName} {candidate.lastName}</h1>
      <p class="subtitle">Update personal credentials, skills, verification status, and account standing.</p>
    </div>
  </div>

  <div class="admin-edit-grid">
    <div class="edit-main-col">
      <form id="admin-edit-candidate-form" class="card form-card">
        <input type="hidden" name="userId" value={candidate.id} />
        
        <!-- Account Status Section -->
        <div class="form-section">
          <div class="section-title-row">
            <h3>Account Standing & Verification</h3>
            <span class="user-id-pill">ID: {candidate.id}</span>
          </div>

          <div class="form-grid mt-3">
            <div class="form-group">
              <label for="isActive">Account Status <span class="req">*</span></label>
              <select id="isActive" name="isActive">
                <option value="true" selected={candidate.isActive === true}>🟢 Active Account (Allowed to apply)</option>
                <option value="false" selected={candidate.isActive === false}>🔴 Suspended / Blocked (Cannot apply to jobs)</option>
              </select>
            </div>

            <div class="form-group">
              <label for="verifiedStatus">Identity Verification <span class="req">*</span></label>
              <select id="verifiedStatus" name="verifiedStatus">
                <option value="verified" selected={candidate.verifiedStatus === 'verified'}>✓ Verified Candidate</option>
                <option value="pending" selected={candidate.verifiedStatus === 'pending'}>⏳ Pending Verification</option>
                <option value="rejected" selected={candidate.verifiedStatus === 'rejected'}>✕ Rejected Candidate</option>
              </select>
            </div>
          </div>

          <div class="form-grid mt-3">
            <div class="form-group full-width">
              <label for="planId">Assigned Subscription Plan</label>
              <select id="planId" name="planId">
                <option value="" selected={!candidate.planId}>No Active Plan (Free Tier)</option>
                {allPlans.map(p => (
                  <option value={p.planId} selected={candidate.planId === p.planId}>
                    {p.planName} ({p.planId}) — ${p.price}/mo
                  </option>
                ))}
              </select>
            </div>
          </div>
        </div>

        <div class="form-divider"></div>

        <!-- Personal Info -->
        <div class="form-section">
          <h3>Personal Details</h3>

          <div class="form-grid mt-3">
            <div class="form-group">
              <label for="firstName">First Name <span class="req">*</span></label>
              <input type="text" id="firstName" name="firstName" required value={candidate.firstName} />
            </div>
            <div class="form-group">
              <label for="lastName">Last Name <span class="req">*</span></label>
              <input type="text" id="lastName" name="lastName" required value={candidate.lastName} />
            </div>
          </div>

          <div class="form-grid mt-3">
            <div class="form-group">
              <label for="email">Email Address (Read-only)</label>
              <input type="email" id="email" value={candidate.email} disabled class="disabled-input" />
            </div>
            <div class="form-group">
              <label for="phone">Contact Phone</label>
              <input type="tel" id="phone" name="phone" value={candidate.phone || ''} placeholder="+1 (555) 000-0000" />
            </div>
          </div>
        </div>

        <div class="form-divider"></div>

        <!-- Professional Profile -->
        <div class="form-section">
          <h3>Professional Profile & Skills</h3>

          <div class="form-group full-width mt-3">
            <label for="headline">Professional Headline</label>
            <input type="text" id="headline" name="headline" value={candidate.headline || ''} placeholder="e.g. Senior Full Stack Developer | React & Node.js" />
          </div>

          <div class="form-grid mt-3">
            <div class="form-group">
              <label for="location">Location / City</label>
              <input type="text" id="location" name="location" value={candidate.location || ''} placeholder="e.g. New York, NY" />
            </div>
            <div class="form-group">
              <label for="experienceYears">Years of Experience</label>
              <input type="number" id="experienceYears" name="experienceYears" value={candidate.experienceYears || ''} placeholder="e.g. 5" />
            </div>
          </div>

          <div class="form-group full-width mt-3">
            <label for="skills">Key Skills (Comma separated)</label>
            <input type="text" id="skills" name="skills" value={skillsText} placeholder="React, TypeScript, Node.js, Python, PostgreSQL" />
          </div>

          <div class="form-group full-width mt-3">
            <label for="bio">Personal Biography & Summary</label>
            <textarea id="bio" name="bio" rows="4" placeholder="Brief overview of experience, career goals, and background...">{candidate.bio || ''}</textarea>
          </div>
        </div>

        <div class="form-divider"></div>

        <!-- Portfolios & Social Links -->
        <div class="form-section">
          <h3>Links & Portfolio</h3>
          <div class="form-grid mt-3">
            <div class="form-group">
              <label for="linkedinUrl">LinkedIn URL</label>
              <input type="url" id="linkedinUrl" name="linkedinUrl" value={candidate.linkedinUrl || ''} placeholder="https://linkedin.com/in/username" />
            </div>
            <div class="form-group">
              <label for="portfolioUrl">Portfolio / Website URL</label>
              <input type="url" id="portfolioUrl" name="portfolioUrl" value={candidate.portfolioUrl || ''} placeholder="https://portfolio.com" />
            </div>
          </div>
        </div>

        <div class="form-divider"></div>

        <!-- Security & Admin Password Reset Section -->
        <div class="form-section">
          <h3>🔐 Admin Password Reset</h3>
          <p class="sec-subtitle">Force reset the password for this candidate account.</p>
          <div class="form-grid mt-3">
            <div class="form-group">
              <label for="newPasswordInput">New Password</label>
              <input type="password" id="newPasswordInput" placeholder="Enter at least 6 characters" minlength="6" />
            </div>
            <div class="form-group align-end">
              <button type="button" class="btn btn-warning" id="admin-reset-pwd-btn">
                🔑 Reset Account Password
              </button>
            </div>
          </div>
        </div>

        <div class="form-actions-bar mt-4">
          <a href="/masteradmin/users" class="btn btn-outline">Cancel</a>
          <button type="submit" class="btn btn-primary btn-glow" id="save-candidate-btn">
            Save & Update Candidate Profile
          </button>
        </div>
      </form>
    </div>

    <!-- Candidate Sidebar -->
    <div class="edit-sidebar-col">
      <div class="card sidebar-card">
        <h3>Candidate Overview</h3>
        <div class="user-summary-box">
          <div class="user-avatar-lg">
            {candidate.firstName.charAt(0).toUpperCase()}
          </div>
          <div>
            <strong>{candidate.firstName} {candidate.lastName}</strong>
            <p>{candidate.headline || 'Job Seeker'}</p>
            <span class="user-email-txt">{candidate.email}</span>
          </div>
        </div>

        <div class="sidebar-divider"></div>

        <div class="meta-item-row">
          <span class="meta-lbl">Registered Date</span>
          <span class="meta-val">{candidate.createdAt ? new Date(candidate.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—'}</span>
        </div>
        <div class="meta-item-row">
          <span class="meta-lbl">Total Applications</span>
          <span class="meta-val highlight">{totalApplications}</span>
        </div>

        <div class="sidebar-divider"></div>

        <h3>Danger Zone</h3>
        <p class="sec-text">Permanently delete this candidate account and remove all their job applications.</p>
        <button type="button" class="btn btn-danger w-full mt-2" id="delete-candidate-btn">
          🗑️ Delete Candidate Account
        </button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  const form = document.getElementById('admin-edit-candidate-form') as HTMLFormElement | null;
  const saveBtn = document.getElementById('save-candidate-btn') as HTMLButtonElement | null;
  const deleteBtn = document.getElementById('delete-candidate-btn') as HTMLButtonElement | null;
  const resetPwdBtn = document.getElementById('admin-reset-pwd-btn') as HTMLButtonElement | null;
  const newPasswordInput = document.getElementById('newPasswordInput') as HTMLInputElement | null;

  if (form && saveBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data: Record<string, any> = Object.fromEntries(formData.entries());

      const originalText = saveBtn.innerText;
      saveBtn.innerText = 'Saving Changes...';
      saveBtn.disabled = true;

      try {
        const res = await fetch('/api/admin/users/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(data)
        });

        const result = await res.json();

        if (res.ok) {
          // @ts-ignore
          if (window.showToast) window.showToast('Candidate profile updated successfully!');
          setTimeout(() => {
            window.location.href = '/masteradmin/users';
          }, 800);
        } else {
          // @ts-ignore
          if (window.showToast) window.showToast(result.error || 'Failed to update candidate', 'error');
          saveBtn.innerText = originalText;
          saveBtn.disabled = false;
        }
      } catch (err) {
        // @ts-ignore
        if (window.showToast) window.showToast('An error occurred while saving.', 'error');
        saveBtn.innerText = originalText;
        saveBtn.disabled = false;
      }
    });
  }

  if (resetPwdBtn && newPasswordInput) {
    resetPwdBtn.addEventListener('click', async () => {
      const newPassword = newPasswordInput.value.trim();
      const userId = (document.querySelector('input[name="userId"]') as HTMLInputElement)?.value;

      if (!newPassword || newPassword.length < 6) {
        // @ts-ignore
        if (window.showToast) window.showToast('Please enter a new password of at least 6 characters.', 'error');
        return;
      }

      resetPwdBtn.innerText = 'Resetting...';
      resetPwdBtn.disabled = true;

      try {
        const res = await fetch('/api/admin/users/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ userId, newPassword })
        });

        const result = await res.json();
        if (res.ok) {
          // @ts-ignore
          if (window.showToast) window.showToast('Password reset successfully!');
          newPasswordInput.value = '';
        } else {
          // @ts-ignore
          if (window.showToast) window.showToast(result.error || 'Failed to reset password', 'error');
        }
      } catch (err) {
        // @ts-ignore
        if (window.showToast) window.showToast('Error resetting password.', 'error');
      } finally {
        resetPwdBtn.innerText = '🔑 Reset Account Password';
        resetPwdBtn.disabled = false;
      }
    });
  }

  if (deleteBtn) {
    deleteBtn.addEventListener('click', async () => {
      const confirmDelete = confirm('Are you sure you want to PERMANENTLY delete this candidate account? All submitted applications and data will be deleted.');
      if (!confirmDelete) return;

      const userId = (document.querySelector('input[name="userId"]') as HTMLInputElement)?.value;
      if (!userId) return;

      deleteBtn.innerText = 'Deleting...';
      deleteBtn.disabled = true;

      try {
        const res = await fetch('/api/admin/users/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ userId })
        });

        if (res.ok) {
          // @ts-ignore
          if (window.showToast) window.showToast('Candidate deleted successfully.');
          window.location.href = '/masteradmin/users';
        } else {
          const result = await res.json();
          // @ts-ignore
          if (window.showToast) window.showToast(result.error || 'Failed to delete candidate', 'error');
          deleteBtn.innerText = '🗑️ Delete Candidate Account';
          deleteBtn.disabled = false;
        }
      } catch (err) {
        // @ts-ignore
        if (window.showToast) window.showToast('An error occurred during deletion.', 'error');
        deleteBtn.innerText = '🗑️ Delete Candidate Account';
        deleteBtn.disabled = false;
      }
    });
  }
</script>

<style>
  .mb-4 { margin-bottom: 1.75rem; }
  .mb-3 { margin-bottom: 1rem; }
  .mt-3 { margin-top: 1rem; }
  .mt-4 { margin-top: 1.5rem; }
  .mt-2 { margin-top: 0.5rem; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }
  .back-link:hover { text-decoration: underline; }

  .badge-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(99, 102, 241, 0.15);
    color: var(--color-primary);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .header-titles h1 {
    margin: 0 0 0.3rem 0;
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .subtitle {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .admin-edit-grid {
    display: grid;
    grid-template-columns: 2.5fr 1fr;
    gap: 1.5rem;
  }

  .form-card {
    padding: 2rem;
  }

  .form-section h3 {
    margin: 0 0 0.2rem 0;
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .sec-subtitle {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .user-id-pill {
    font-size: 0.75rem;
    font-weight: 700;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    color: var(--color-text-muted);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group.full-width {
    grid-column: 1 / -1;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .req { color: #ef4444; }

  .form-group input, .form-group select, .form-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-text-main);
    font-size: 0.92rem;
    outline: none;
    font-family: inherit;
  }

  .disabled-input {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .align-end {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
  }

  .btn-warning {
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.3);
    font-weight: 700;
    padding: 0.75rem 1.25rem;
    border-radius: 10px;
    cursor: pointer;
  }

  .form-divider {
    height: 1px;
    background: var(--color-border);
    margin: 1.75rem 0;
  }

  .form-actions-bar {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
  }

  .sidebar-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sidebar-card h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .user-summary-box {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .user-avatar-lg {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: white;
    font-size: 1.4rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .user-summary-box strong {
    display: block;
    color: var(--color-text-main);
    font-size: 1rem;
  }
  .user-summary-box p {
    margin: 0.1rem 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .user-email-txt {
    font-size: 0.78rem;
    color: var(--color-primary);
  }

  .sidebar-divider {
    height: 1px;
    background: var(--color-border);
  }

  .meta-item-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
  }
  .meta-lbl { color: var(--color-text-muted); }
  .meta-val { font-weight: 700; color: var(--color-text-main); }
  .meta-val.highlight { color: var(--color-primary); font-size: 1rem; }

  .sec-text {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .w-full { width: 100%; }

  @media (max-width: 1024px) {
    .admin-edit-grid { grid-template-columns: 1fr; }
  }
</style>
