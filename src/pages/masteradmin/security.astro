---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getDb } from '../../lib/db';
import { users, jobPostings, applications, posts } from '../../db/schema';
import { evaluateEmployer, evaluateCandidate, type FraudEvaluation } from '../../lib/fraud-detector';

// @ts-ignore
const currentUser = Astro.locals.user;
if (!currentUser || (currentUser.userType !== 'masteradmin' && currentUser.userType !== 'superadmin' && currentUser.userType !== 'admin')) {
  return Astro.redirect('/login');
}

const db = getDb();

// Fetch all users, jobs, apps, and posts for initial server-side scan safely
const allUsers = await db.select().from(users).all();
const allJobs = await db.select().from(jobPostings).all();
const allApps = await db.select().from(applications).all();
let allPosts: any[] = [];
try {
  allPosts = await db.select().from(posts).all();
} catch (e) {
  allPosts = [];
}

const jobsByEmployer: Record<string, any[]> = {};
for (const job of allJobs) {
  if (!jobsByEmployer[job.employerId]) jobsByEmployer[job.employerId] = [];
  jobsByEmployer[job.employerId].push(job);
}

const appsByCandidate: Record<string, any[]> = {};
for (const app of allApps) {
  if (!appsByCandidate[app.applicantId]) appsByCandidate[app.applicantId] = [];
  appsByCandidate[app.applicantId].push(app);
}

const postsByAuthor: Record<string, any[]> = {};
for (const post of allPosts) {
  if (!postsByAuthor[post.authorId]) postsByAuthor[post.authorId] = [];
  postsByAuthor[post.authorId].push(post);
}

const evaluations: FraudEvaluation[] = [];

for (const u of allUsers) {
  if (u.userType === 'superadmin' || u.userType === 'masteradmin' || u.userType === 'admin') continue;

  if (u.userType === 'employer') {
    const uJobs = jobsByEmployer[u.id] || [];
    const uPosts = postsByAuthor[u.id] || [];
    evaluations.push(evaluateEmployer(u, uJobs, uPosts));
  } else if (u.userType === 'employee') {
    const uApps = appsByCandidate[u.id] || [];
    const uPosts = postsByAuthor[u.id] || [];
    evaluations.push(evaluateCandidate(u, uApps, uPosts));
  }
}

// Sort by highest risk score first
evaluations.sort((a, b) => b.riskScore - a.riskScore);

const totalScanned = evaluations.length;
const highRiskCount = evaluations.filter(e => e.riskLevel === 'HIGH').length;
const mediumRiskCount = evaluations.filter(e => e.riskLevel === 'MEDIUM').length;
const cleanCount = evaluations.filter(e => e.riskLevel === 'LOW').length;
const suspendedCount = evaluations.filter(e => !e.isActive).length;
const safetyPercentage = totalScanned > 0 ? (((cleanCount + mediumRiskCount) / totalScanned) * 100).toFixed(1) : '100.0';
---

<DashboardLayout title="Fraud & Spam Security Center" userType="masteradmin" activePath="/masteradmin/security">
  <div class="security-page-wrapper">
    <!-- Security Banner -->
    <div class="security-banner">
      <div class="banner-content">
        <div class="banner-badge">
          <span class="pulse-dot"></span>
          Automated Threat Intelligence
        </div>
        <h1>Fraud & Spam Security Center 🛡️</h1>
        <p>Continuous AI and heuristic scanning across all accounts, job postings, cover letters, and feed activity to detect phishing, scams, disposable bots, and spam.</p>
      </div>
      <div class="banner-actions">
        <button type="button" id="runScanBtn" class="btn btn-scan">
          <svg class="scan-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
          </svg>
          <span id="scanBtnText">Run Deep Scan</span>
        </button>
      </div>
    </div>

    <!-- Security Metrics Grid -->
    <div class="metrics-grid">
      <div class="metric-card metric-danger">
        <div class="metric-icon-wrap icon-red">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
        </div>
        <div class="metric-info">
          <span class="metric-val" id="highRiskStat">{highRiskCount}</span>
          <span class="metric-label">High Risk Threats</span>
        </div>
      </div>

      <div class="metric-card metric-warning">
        <div class="metric-icon-wrap icon-amber">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
        </div>
        <div class="metric-info">
          <span class="metric-val" id="mediumRiskStat">{mediumRiskCount}</span>
          <span class="metric-label">Medium Warnings</span>
        </div>
      </div>

      <div class="metric-card metric-blocked">
        <div class="metric-icon-wrap icon-purple">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
          </svg>
        </div>
        <div class="metric-info">
          <span class="metric-val" id="suspendedStat">{suspendedCount}</span>
          <span class="metric-label">Blocked / Suspended</span>
        </div>
      </div>

      <div class="metric-card metric-safe">
        <div class="metric-icon-wrap icon-green">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <div class="metric-info">
          <span class="metric-val" id="safetyStat">{safetyPercentage}%</span>
          <span class="metric-label">Platform Safety Rate</span>
        </div>
      </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="security-toolbar">
      <div class="search-box">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" id="securitySearchInput" placeholder="Search by name, email, company, or flagged keyword..." />
      </div>

      <div class="filter-group">
        <div class="tab-filters">
          <button type="button" class="tab-btn active" data-filter="all">All ({totalScanned})</button>
          <button type="button" class="tab-btn" data-filter="high">🔴 High Risk ({highRiskCount})</button>
          <button type="button" class="tab-btn" data-filter="employer">🏢 Employers</button>
          <button type="button" class="tab-btn" data-filter="employee">👤 Candidates</button>
          <button type="button" class="tab-btn" data-filter="blocked">🛑 Blocked ({suspendedCount})</button>
        </div>
      </div>
    </div>

    <!-- Threat Records Table -->
    <div class="table-card">
      <div class="table-responsive">
        <table class="security-table">
          <thead>
            <tr>
              <th>Account & Role</th>
              <th>Threat Score</th>
              <th>Detected Risk Flags</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="threatTableBody">
            {evaluations.length === 0 ? (
              <tr>
                <td colspan="5" class="empty-cell">
                  <div class="empty-state">
                    <div class="empty-icon">🛡️</div>
                    <h3>No Threats Detected</h3>
                    <p>All scanned accounts meet security compliance policies.</p>
                  </div>
                </td>
              </tr>
            ) : (
              evaluations.map((item) => {
                const isBlocked = !item.isActive;
                const scoreClass = item.riskLevel === 'HIGH' ? 'score-high' : item.riskLevel === 'MEDIUM' ? 'score-medium' : 'score-low';
                const roleBadgeClass = item.userType === 'employer' ? 'role-employer' : 'role-candidate';

                return (
                  <tr
                    class={`threat-row ${isBlocked ? 'is-blocked-row' : ''}`}
                    data-user-id={item.userId}
                    data-user-type={item.userType}
                    data-risk-level={item.riskLevel.toLowerCase()}
                    data-is-blocked={isBlocked ? 'true' : 'false'}
                    data-search-text={`${item.name} ${item.email} ${item.companyName || ''} ${item.flags.join(' ')}`.toLowerCase()}
                  >
                    <td>
                      <div class="user-profile-cell">
                        <div class="user-avatar">
                          {item.name.charAt(0).toUpperCase()}
                        </div>
                        <div class="user-details">
                          <div class="name-row">
                            <strong class="user-name">{item.name}</strong>
                            <span class={`role-pill ${roleBadgeClass}`}>
                              {item.userType === 'employer' ? '🏢 Employer' : '👤 Candidate'}
                            </span>
                          </div>
                          <span class="user-email">{item.email}</span>
                          {item.companyName && item.companyName !== 'Not Provided' && (
                            <small class="company-sub">Company: {item.companyName}</small>
                          )}
                        </div>
                      </div>
                    </td>

                    <td>
                      <div class="score-badge-container">
                        <div class={`score-badge ${scoreClass}`}>
                          <span class="score-num">{item.riskScore}</span>
                          <span class="score-label">/100</span>
                        </div>
                        <span class={`risk-level-tag ${scoreClass}`}>
                          {item.riskLevel} RISK
                        </span>
                      </div>
                    </td>

                    <td>
                      <div class="flags-cell">
                        {item.flags.length === 0 ? (
                          <span class="flag-clean">✓ No active risk flags</span>
                        ) : (
                          <div class="flags-list">
                            {item.flags.map(flag => (
                              <div class="flag-chip">{flag}</div>
                            ))}
                          </div>
                        )}
                        {item.sampleContent && (
                          <div class="evidence-box">
                            <span class="evidence-title">Sample Evidence:</span>
                            <span class="evidence-text">{item.sampleContent}</span>
                          </div>
                        )}
                      </div>
                    </td>

                    <td>
                      <div class="status-cell">
                        {isBlocked ? (
                          <span class="status-pill status-blocked">🛑 Blocked</span>
                        ) : (
                          <span class="status-pill status-active">🟢 Active</span>
                        )}
                      </div>
                    </td>

                    <td>
                      <div class="action-buttons-group">
                        {isBlocked ? (
                          <button
                            type="button"
                            class="action-btn btn-unblock"
                            data-action="unblock"
                            data-user-id={item.userId}
                            title="Reactivate Account"
                          >
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M20 6L9 17l-5-5"/>
                            </svg>
                            Unblock
                          </button>
                        ) : (
                          <button
                            type="button"
                            class="action-btn btn-block"
                            data-action="block"
                            data-user-id={item.userId}
                            title="Block and Suspend Account"
                          >
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                            </svg>
                            Block
                          </button>
                        )}

                        <button
                          type="button"
                          class="action-btn btn-delete"
                          data-action="delete"
                          data-user-id={item.userId}
                          data-user-name={item.name}
                          data-user-email={item.email}
                          title="Permanently Delete Account & Clean Data"
                        >
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          </svg>
                          Delete
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="deleteSecurityModal" class="security-modal-overlay" style="display: none;">
    <div class="security-modal-content">
      <div class="modal-header-danger">
        <div class="modal-icon-danger">🗑️</div>
        <div>
          <h3>Purge Fraudulent Account</h3>
          <p>Permanently remove account and purge associated spam records</p>
        </div>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to permanently delete <strong id="deleteTargetUser"></strong> (<span id="deleteTargetEmail"></span>)?</p>
        <div class="purge-warning-box">
          ⚠️ <strong>Cascade Cleanup:</strong> All posted spam jobs, applicant submissions, cover letters, and feed messages created by this user will be completely wiped from the database.
        </div>
      </div>
      <div class="modal-actions">
        <button type="button" id="cancelDeleteBtn" class="btn btn-outline">Cancel</button>
        <button type="button" id="confirmDeleteBtn" class="btn btn-danger-glow">Confirm Permanent Deletion</button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  let activeFilter = 'all';
  let targetDeleteId = '';

  // DOM elements
  const searchInput = document.getElementById('securitySearchInput') as HTMLInputElement | null;
  const tabBtns = document.querySelectorAll('.tab-btn');
  const rows = document.querySelectorAll('.threat-row');
  const runScanBtn = document.getElementById('runScanBtn') as HTMLButtonElement | null;
  const scanBtnText = document.getElementById('scanBtnText');

  const deleteModal = document.getElementById('deleteSecurityModal');
  const deleteTargetUser = document.getElementById('deleteTargetUser');
  const deleteTargetEmail = document.getElementById('deleteTargetEmail');
  const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
  const confirmDeleteBtn = document.getElementById('confirmDeleteBtn') as HTMLButtonElement | null;

  // Filter and Search logic
  function applyFilters() {
    const q = (searchInput?.value || '').toLowerCase().trim();

    rows.forEach((row) => {
      const el = row as HTMLElement;
      const riskLevel = el.getAttribute('data-risk-level') || '';
      const userType = el.getAttribute('data-user-type') || '';
      const isBlocked = el.getAttribute('data-is-blocked') === 'true';
      const searchText = el.getAttribute('data-search-text') || '';

      let matchesFilter = true;
      if (activeFilter === 'high') matchesFilter = riskLevel === 'high';
      else if (activeFilter === 'employer') matchesFilter = userType === 'employer';
      else if (activeFilter === 'employee') matchesFilter = userType === 'employee';
      else if (activeFilter === 'blocked') matchesFilter = isBlocked;

      const matchesSearch = !q || searchText.includes(q);

      if (matchesFilter && matchesSearch) {
        el.style.display = '';
      } else {
        el.style.display = 'none';
      }
    });
  }

  searchInput?.addEventListener('input', applyFilters);

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilter = btn.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });

  // Action Button Handlers (Delegated)
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.action-btn') as HTMLButtonElement | null;
    if (!btn) return;

    const action = btn.getAttribute('data-action');
    const userId = btn.getAttribute('data-user-id');

    if (action === 'delete') {
      targetDeleteId = userId || '';
      const name = btn.getAttribute('data-user-name') || 'User';
      const email = btn.getAttribute('data-user-email') || '';
      if (deleteTargetUser) deleteTargetUser.textContent = name;
      if (deleteTargetEmail) deleteTargetEmail.textContent = email;
      if (deleteModal) deleteModal.style.display = 'flex';
      return;
    }

    if (action === 'block' || action === 'unblock') {
      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span>Processing...</span>';

      try {
        const res = await fetch('/api/superadmin/security/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ userId, action })
        });

        const data = await res.json();
        if (res.ok) {
          // @ts-ignore
          if (window.showToast) window.showToast(data.message || `Account ${action}ed successfully!`);
          setTimeout(() => window.location.reload(), 600);
        } else {
          // @ts-ignore
          if (window.showToast) window.showToast(data.error || 'Action failed', 'error');
          btn.disabled = false;
          btn.innerHTML = originalText;
        }
      } catch (err) {
        // @ts-ignore
        if (window.showToast) window.showToast('Network error', 'error');
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    }
  });

  // Delete Modal Handlers
  cancelDeleteBtn?.addEventListener('click', () => {
    if (deleteModal) deleteModal.style.display = 'none';
    targetDeleteId = '';
  });

  confirmDeleteBtn?.addEventListener('click', async () => {
    if (!targetDeleteId) return;

    const origText = confirmDeleteBtn.innerText;
    confirmDeleteBtn.innerText = 'Purging Account...';
    confirmDeleteBtn.disabled = true;

    try {
      const res = await fetch('/api/superadmin/security/action', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ userId: targetDeleteId, action: 'delete' })
      });

      const data = await res.json();
      if (res.ok) {
        // @ts-ignore
        if (window.showToast) window.showToast(data.message || 'Account purged successfully!');
        if (deleteModal) deleteModal.style.display = 'none';
        setTimeout(() => window.location.reload(), 700);
      } else {
        // @ts-ignore
        if (window.showToast) window.showToast(data.error || 'Failed to delete account', 'error');
        confirmDeleteBtn.innerText = origText;
        confirmDeleteBtn.disabled = false;
      }
    } catch (err) {
      // @ts-ignore
      if (window.showToast) window.showToast('Network error during deletion', 'error');
      confirmDeleteBtn.innerText = origText;
      confirmDeleteBtn.disabled = false;
    }
  });

  // Live Deep Scan Button Handler
  runScanBtn?.addEventListener('click', async () => {
    if (!runScanBtn) return;
    runScanBtn.disabled = true;
    runScanBtn.classList.add('scanning');
    if (scanBtnText) scanBtnText.innerText = 'Analyzing Heuristics...';

    try {
      const res = await fetch('/api/superadmin/security/scan');
      const data = await res.json();

      if (res.ok && data.stats) {
        // Update stats
        const highEl = document.getElementById('highRiskStat');
        const medEl = document.getElementById('mediumRiskStat');
        const susEl = document.getElementById('suspendedStat');
        const safeEl = document.getElementById('safetyStat');

        if (highEl) highEl.innerText = data.stats.highRiskCount;
        if (medEl) medEl.innerText = data.stats.mediumRiskCount;
        if (susEl) susEl.innerText = data.stats.suspendedCount;
        if (safeEl) safeEl.innerText = `${data.stats.safetyPercentage}%`;

        // @ts-ignore
        if (window.showToast) window.showToast(`Scan complete: ${data.stats.totalScanned} accounts analyzed. ${data.stats.highRiskCount} high-risk flags.`);
        setTimeout(() => window.location.reload(), 1200);
      } else {
        // @ts-ignore
        if (window.showToast) window.showToast(data.error || 'Scan failed', 'error');
      }
    } catch (err) {
      // @ts-ignore
      if (window.showToast) window.showToast('Failed to connect to scan engine', 'error');
    } finally {
      runScanBtn.disabled = false;
      runScanBtn.classList.remove('scanning');
      if (scanBtnText) scanBtnText.innerText = 'Run Deep Scan';
    }
  });
</script>

<style>
  .security-page-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* Banner */
  .security-banner {
    background: linear-gradient(135deg, rgba(30, 27, 75, 0.8) 0%, rgba(15, 23, 42, 0.9) 100%);
    border: 1px solid rgba(139, 92, 246, 0.25);
    border-radius: var(--border-radius-lg, 1rem);
    padding: 2rem 2.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  html[data-theme="light"] .security-banner {
    background: linear-gradient(135deg, #FAF5FF 0%, #FFFFFF 100%);
    border-color: #E9D5FF;
    box-shadow: 0 4px 20px rgba(124, 58, 237, 0.06);
  }

  .banner-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(139, 92, 246, 0.15);
    border: 1px solid rgba(139, 92, 246, 0.35);
    color: #A78BFA;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  html[data-theme="light"] .banner-badge {
    color: #7C3AED;
    background: #F3E8FF;
    border-color: #DDD6FE;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10B981;
    box-shadow: 0 0 8px #10B981;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.2); opacity: 1; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  .security-banner h1 {
    font-size: 1.85rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    color: var(--color-text-main);
  }

  .security-banner p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: 0;
    max-width: 680px;
    line-height: 1.5;
  }

  .btn-scan {
    background: linear-gradient(135deg, #8B5CF6 0%, #6366F1 100%);
    color: white !important;
    border: none;
    padding: 0.85rem 1.6rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(139, 92, 246, 0.4);
    transition: all 0.2s ease;
  }

  .btn-scan:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(139, 92, 246, 0.5);
  }

  .btn-scan.scanning .scan-icon {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .metric-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    transition: transform 0.2s ease;
  }

  .metric-card:hover {
    transform: translateY(-2px);
  }

  .metric-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
