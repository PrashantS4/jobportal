---
import { getResumeViewerUrl } from '../../lib/resume-helper';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getDb } from '../../lib/db';
import { applications, jobPostings, users } from '../../db/schema';
import { eq, desc, and } from 'drizzle-orm';

const payload = Astro.locals.user;
if (!payload || payload.userType !== 'employer') {
  return Astro.redirect('/login');
}

const statusFilter = Astro.url.searchParams.get('status') || '';
const jobFilter = Astro.url.searchParams.get('jobId') || '';

const db = getDb();

let query = db.select({
  id: applications.id,
  status: applications.status,
  appliedAt: applications.appliedAt,
  jobTitle: jobPostings.jobTitle,
  jobId: jobPostings.id,
  applicantFirstName: users.firstName,
  applicantLastName: users.lastName,
  applicantEmail: users.email,
  resumeUrl: applications.resumeUrl,
  aiScore: applications.aiScore
})
.from(applications)
.innerJoin(jobPostings, eq(applications.jobPostingId, jobPostings.id))
.innerJoin(users, eq(applications.applicantId, users.id))
.where(eq(applications.employerId, payload.userId));

const allEmployerApps = await query.orderBy(desc(applications.appliedAt)).all();

const jobSpecificApps = jobFilter ? allEmployerApps.filter(a => a.jobId === jobFilter) : allEmployerApps;
const currentJobTitle = jobSpecificApps[0]?.jobTitle || (jobFilter ? 'Selected Job' : '');

// Filter in-memory if query params provided
let filteredApps = jobSpecificApps;
if (statusFilter) {
  filteredApps = filteredApps.filter(a => a.status === statusFilter);
}

const counts = {
  all: jobSpecificApps.length,
  received: jobSpecificApps.filter(a => a.status === 'received').length,
  under_review: jobSpecificApps.filter(a => a.status === 'under_review').length,
  shortlisted: jobSpecificApps.filter(a => a.status === 'shortlisted').length,
  accepted: jobSpecificApps.filter(a => a.status === 'accepted').length,
  rejected: jobSpecificApps.filter(a => a.status === 'rejected').length,
};

const getTabUrl = (status?: string) => {
  const params = new URLSearchParams();
  if (jobFilter) params.set('jobId', jobFilter);
  if (status) params.set('status', status);
  const qs = params.toString();
  return `/employer/applications${qs ? `?${qs}` : ''}`;
};
---

<DashboardLayout title="Applications Management" userType="employer" activePath="/employer/applications">
  <div class="header-content mb-4">
    <div>
      <span class="badge-tag">Recruiter Workspace</span>
      <h1>Received Applications</h1>
      <p class="subtitle">
        {jobFilter ? `Viewing candidates who applied for "${currentJobTitle}"` : 'Review applicant submissions, compatibility scores, and update candidate hiring stages.'}
      </p>
    </div>
    <a href={jobFilter ? `/employer/screening?jobId=${jobFilter}` : '/employer/screening'} class="btn btn-primary btn-sm btn-header-ai">
      ⚡ AI Smart Screening & Ranking
    </a>
  </div>

  {jobFilter && (
    <div class="active-filter-banner mb-4">
      <div class="active-filter-info">
        <span class="filter-icon">💼</span>
        <span>Filtered by Job: <strong>{currentJobTitle}</strong> ({jobSpecificApps.length} applicants)</span>
      </div>
      <a href="/employer/applications" class="clear-filter-btn" title="View all applications across all jobs">
        ✕ Show All Jobs ({allEmployerApps.length})
      </a>
    </div>
  )}

  <!-- Status Filter Pills Tabs -->
  <div class="filter-tabs mb-4">
    <a href={getTabUrl()} class={`tab-pill ${!statusFilter ? 'active' : ''}`}>
      All Applications <span class="tab-count">{counts.all}</span>
    </a>
    <a href={getTabUrl('received')} class={`tab-pill ${statusFilter === 'received' ? 'active' : ''}`}>
      Received <span class="tab-count">{counts.received}</span>
    </a>
    <a href={getTabUrl('under_review')} class={`tab-pill ${statusFilter === 'under_review' ? 'active' : ''}`}>
      Under Review <span class="tab-count">{counts.under_review}</span>
    </a>
    <a href={getTabUrl('shortlisted')} class={`tab-pill ${statusFilter === 'shortlisted' ? 'active' : ''}`}>
      Shortlisted <span class="tab-count">{counts.shortlisted}</span>
    </a>
    <a href={getTabUrl('accepted')} class={`tab-pill ${statusFilter === 'accepted' ? 'active' : ''}`}>
      Hired / Accepted <span class="tab-count">{counts.accepted}</span>
    </a>
    <a href={getTabUrl('rejected')} class={`tab-pill ${statusFilter === 'rejected' ? 'active' : ''}`}>
      Rejected <span class="tab-count">{counts.rejected}</span>
    </a>
  </div>

  <div class="applications-container">
    {filteredApps.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon">📂</div>
        <h3>No applications match this filter</h3>
        <p>There are no candidate applications currently under "{statusFilter ? statusFilter.replace('_', ' ') : 'All'}".</p>
        <a href="/employer/applications" class="btn btn-outline mt-3">View All Applications</a>
      </div>
    ) : (
      <div class="table-responsive">
        <table class="data-table" id="applications-table">
          <thead>
            <tr>
              <th>Applicant Name</th>
              <th>Applied Role</th>
              <th style="cursor: pointer;" title="Sort by AI Match">AI Match ↕️</th>
              <th>Status</th>
              <th>Submitted Date</th>
              <th class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            {filteredApps.map((app) => (
              <tr data-score={app.aiScore || 0} class="app-row">
                <td class="col-applicant">
                  <div class="applicant-cell">
                    <div class="applicant-avatar">
                      {(app.applicantFirstName?.[0] || 'C').toUpperCase()}
                    </div>
                    <div>
                      <strong class="applicant-name">{app.applicantFirstName} {app.applicantLastName}</strong>
                      <span class="applicant-email">{app.applicantEmail}</span>
                    </div>
                  </div>
                </td>
                <td class="col-role">
                  <span class="job-role-text">💼 {app.jobTitle}</span>
                </td>
                <td class="col-match">
                  <div class="mobile-badges-wrapper">
                    {app.aiScore !== null ? (
                      <span class="match-score-pill" style={`background: ${app.aiScore >= 80 ? 'rgba(16, 185, 129, 0.12)' : app.aiScore >= 50 ? 'rgba(245, 158, 11, 0.12)' : 'rgba(239, 68, 68, 0.12)'}; color: ${app.aiScore >= 80 ? '#10b981' : app.aiScore >= 50 ? '#f59e0b' : '#ef4444'}; border: 1px solid ${app.aiScore >= 80 ? 'rgba(16, 185, 129, 0.3)' : app.aiScore >= 50 ? 'rgba(245, 158, 11, 0.3)' : 'rgba(239, 68, 68, 0.3)'};`}>
                        ✨ {app.aiScore}% Match
                      </span>
                    ) : (
                      <div class="match-calc-wrap">
                        <span class="badge-na">N/A</span>
                        <button class="btn-icon btn-recalculate" data-id={app.id} title="Calculate AI Match">
                          <span class="icon">⟳</span>
                        </button>
                      </div>
                    )}
                    <span class={`status-pill status-${app.status} desktop-status-pill`}>
                      {app.status.replace('_', ' ').toUpperCase()}
                    </span>
                  </div>
                </td>
                <td class="col-status">
                  <span class={`status-pill status-${app.status} mobile-only-status`}>
                    {app.status.replace('_', ' ').toUpperCase()}
                  </span>
                </td>
                <td class="col-date">
                  <span class="date-text">
                    📅 {app.appliedAt ? new Date(app.appliedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—'}
                  </span>
                </td>
                <td class="col-actions">
                  <div class="mobile-footer-line">
                    <span class="mobile-date-val">
                      📅 {app.appliedAt ? new Date(app.appliedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—'}
                    </span>
                  </div>
                  <div class="actions">
                    {app.resumeUrl && (
                      <a href={getResumeViewerUrl(app.resumeUrl, Astro.url.origin)} target="_blank" class="btn-action-icon" title="View Resume PDF">
                        <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                      </a>
                    )}
                    <a
                      href={`/employer/interviews?appId=${app.id}&action=schedule`}
                      class="btn btn-outline btn-sm btn-schedule"
                      title="Schedule Interview Round"
                    >
                      <span>📅</span> Schedule
                    </a>
                    <a href={`/employer/applications/${app.id}`} class="btn btn-primary btn-sm btn-review" title="View & Review Application">
                      Review &rarr;
                    </a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</DashboardLayout>

<script>
  // Simple client-side sorting for AI Match score
  document.addEventListener('DOMContentLoaded', () => {
    const table = document.getElementById('applications-table');
    if (!table) return;
    
    const thead = table.querySelector('thead');
    const tbody = table.querySelector('tbody');
    if (!thead || !tbody) return;
    
    const ths = thead.querySelectorAll('th');
    if (ths.length < 3) return;
    
    const sortBtn = ths[2]; // AI Match header
    let sortDesc = true;
    
    sortBtn.addEventListener('click', () => {
      const rows = Array.from(tbody.querySelectorAll('tr'));
      
      rows.sort((a, b) => {
        const scoreA = parseInt(a.getAttribute('data-score') || '0', 10);
        const scoreB = parseInt(b.getAttribute('data-score') || '0', 10);
        return sortDesc ? scoreB - scoreA : scoreA - scoreB;
      });
      
      sortDesc = !sortDesc;
      sortBtn.textContent = `AI Match ${sortDesc ? '⬇️' : '⬆️'}`;
      
      rows.forEach(r => tbody.appendChild(r));
    });

    // Handle recalculating AI Match button
    const recalcBtns = document.querySelectorAll('.btn-recalculate');
    recalcBtns.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const appId = btn.getAttribute('data-id');
        if (!appId) return;

        btn.classList.add('spinning');
        try {
          const res = await fetch('/api/employer/recalculate-match', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ applicationId: appId })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            // @ts-ignore
            if (window.showToast) window.showToast('AI Match Score calculated successfully!');
            window.location.reload();
          } else {
            // @ts-ignore
            if (window.showToast) window.showToast(data.error || 'Failed to calculate match score', 'error');
          }
        } catch (err) {
          // @ts-ignore
          if (window.showToast) window.showToast('Network error while calculating match', 'error');
        } finally {
          btn.classList.remove('spinning');
        }
      });
    });
  });
</script>

<style>
