---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getDb } from '../../lib/db';
import { users } from '../../db/schema';
import { eq } from 'drizzle-orm';

const payload = Astro.locals.user;
if (!payload || payload.userType !== 'employer') {
  return Astro.redirect('/login');
}

const db = getDb();
const candidates = await db.select()
  .from(users)
  .where(eq(users.userType, 'employee'))
  .all();
---

<DashboardLayout title="Find Talent" userType="employer" activePath="/employer/candidates">
  <div class="talent-header mb-4">
    <div class="header-titles">
      <span class="badge-tag">Talent Discovery</span>
      <h1>Find Top Candidates</h1>
      <p class="subtitle">Explore verified developers, designers, and specialists ready for their next role.</p>
    </div>
    <div class="search-box">
      <input type="text" id="candidate-search" placeholder="Search by name, skill, or role..." />
    </div>
  </div>

  <div class="candidates-container">
    {candidates.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon">👥</div>
        <h3>No Candidates Registered Yet</h3>
        <p>Job seekers will appear here as soon as they sign up and complete their profiles.</p>
      </div>
    ) : (
      <div class="candidates-grid" id="candidates-grid">
        {candidates.map((candidate) => {
          let candidateSkills: string[] = [];
          if (candidate.skills) {
            try {
              const parsed = typeof candidate.skills === 'string' ? JSON.parse(candidate.skills) : candidate.skills;
              if (Array.isArray(parsed)) {
                candidateSkills = parsed.filter((s: any) => typeof s === 'string' && s.trim());
              }
            } catch (e) {}
          }

          return (
            <div class="candidate-card" data-candidate-name={`${candidate.firstName} ${candidate.lastName}`.toLowerCase()} data-candidate-email={candidate.email.toLowerCase()}>
              <a href={`/employer/candidates/${candidate.id}`} class="candidate-header-link">
                <div class="candidate-header">
                  <div class="avatar-wrap">
                    {candidate.avatarUrl ? (
                      <img src={candidate.avatarUrl} alt={`${candidate.firstName} ${candidate.lastName}`} class="avatar-thumb" />
                    ) : (
                      <div class="avatar-initials">
                        {(candidate.firstName?.[0] || 'C').toUpperCase()}
                      </div>
                    )}
                    {candidate.verifiedStatus === 'verified' && (
                      <span class="verified-dot" title="Verified Seeker">✓</span>
                    )}
                  </div>
                  <div class="candidate-titles">
                    <h3>{candidate.firstName} {candidate.lastName}</h3>
                    <span class="candidate-headline">{candidate.headline || 'Active Candidate'}</span>
                  </div>
                </div>
              </a>

              <div class="candidate-body">
                <div class="candidate-detail-item">
                  <span class="detail-icon">✉️</span>
                  <span class="detail-val">{candidate.email}</span>
                </div>
                <div class="candidate-detail-item">
                  <span class="detail-icon">📞</span>
                  <span class="detail-val">{candidate.phone || 'Phone upon request'}</span>
                </div>

                <div class="skills-block mt-3">
                  <span class="skills-label">Core Competencies</span>
                  {candidateSkills.length > 0 ? (
                    <div class="skills-tags">
                      {candidateSkills.map(skill => (
                        <span class="tag">{skill}</span>
                      ))}
                    </div>
                  ) : (
                    <p style="margin: 0; font-size: 0.8rem; color: var(--color-text-muted); font-style: italic;">No skills listed on profile yet</p>
                  )}
                </div>
              </div>

              <div class="candidate-footer">
                <a href={`/employer/candidates/${candidate.id}`} class="btn btn-outline btn-sm btn-profile">
                  👤 View Profile
                </a>
                <a href={`/employer/messages?userId=${candidate.id}`} class="btn btn-primary btn-sm btn-glow btn-message">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                  Message
                </a>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</DashboardLayout>

<style>
  .mb-4 { margin-bottom: 1.75rem; }
  .mt-3 { margin-top: 1rem; }

  .talent-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .badge-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(99, 102, 241, 0.15);
    color: var(--color-primary);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .header-titles h1 {
    margin: 0 0 0.3rem 0;
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .subtitle {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .search-box input {
    min-width: 280px;
    padding: 0.75rem 1.2rem;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-main);
    font-family: inherit;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }
  .search-box input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
  }

  .candidates-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .candidate-card {
    background: var(--color-surface);
    backdrop-filter: blur(16px);
    border-radius: var(--border-radius-lg);
    border: 1px solid var(--color-border);
    padding: 1.5rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08), 0 2px 10px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  .candidate-card:hover {
    transform: translateY(-8px);
    border-color: rgba(99, 102, 241, 0.5);
    box-shadow: 0 20px 40px rgba(99, 102, 241, 0.15), 0 5px 15px rgba(99, 102, 241, 0.08);
  }

  .candidate-header-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .candidate-header-link:hover h3 {
    color: var(--color-primary);
  }

  .candidate-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .avatar-initials {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: white;
    font-weight: 800;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-thumb {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    object-fit: cover;
  }

  .verified-dot {
    position: absolute;
    bottom: -4px;
    right: -4px;
    background: #10b981;
    color: white;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    font-size: 0.65rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-surface);
  }

  .candidate-titles h3 {
    margin: 0 0 0.2rem 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-main);
    transition: color 0.15s ease;
  }

  .candidate-headline {
    font-size: 0.8rem;
    color: var(--color-primary);
    font-weight: 600;
  }

  .candidate-body {
    flex: 1;
    margin-bottom: 1.25rem;
  }

  .candidate-detail-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.4rem;
  }

  .skills-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.4rem;
  }

  .skills-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag {
    padding: 0.2rem 0.55rem;
    background: rgba(99, 102, 241, 0.08);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 6px;
    font-size: 0.75rem;
    color: var(--color-text-main);
    font-weight: 600;
  }

  .candidate-footer {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .btn-profile, .btn-message {
    flex: 1;
    text-align: center;
    justify-content: center;
    font-size: 0.82rem;
    padding: 0.5rem 0.75rem;
  }

  .btn-glow {
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
  }

  .empty-state {
    padding: 5rem 2rem;
    text-align: center;
    background: var(--color-surface);
    backdrop-filter: blur(16px);
    border-radius: var(--border-radius-lg);
    border: 1px solid var(--color-border);
  }
  .empty-icon { font-size: 3rem; margin-bottom: 0.75rem; }

  @media (max-width: 640px) {
    .talent-header {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 1rem !important;
    }
    .search-box {
      width: 100% !important;
    }
    .search-box input {
      width: 100% !important;
      min-width: unset !important;
      box-sizing: border-box !important;
    }
    .candidates-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('candidate-search') as HTMLInputElement;
  const grid = document.getElementById('candidates-grid');

  if (searchInput && grid) {
    searchInput.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.toLowerCase().trim();
      const cards = grid.querySelectorAll('.candidate-card');

      cards.forEach(card => {
        const name = card.getAttribute('data-candidate-name') || '';
        const email = card.getAttribute('data-candidate-email') || '';
        const text = card.textContent?.toLowerCase() || '';

        if (name.includes(val) || email.includes(val) || text.includes(val)) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  }
</script>
