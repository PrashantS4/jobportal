---
import Layout from '../layouts/Layout.astro';
---

<Layout hideNavAndFooter={true}>
  <main class="auth-container">
    <div class="auth-card card">
      <div class="auth-header">
        <h1>Reset Password</h1>
        <p>Enter your email and we'll send you a link to reset your password</p>
      </div>

      <div class="alert alert-success d-none" id="success-alert"></div>
      <div class="alert alert-danger d-none" id="error-alert"></div>

      <form class="auth-form" id="forgot-form">
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" required placeholder="name@example.com" />
        </div>

        <button type="submit" class="btn btn-primary w-full" id="submit-btn">Send Reset Link</button>
      </form>

      <div class="auth-footer">
        <p>Back to <a href="/login" class="text-primary fw-600">Log In</a></p>
      </div>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('forgot-form') as HTMLFormElement;
  const successAlert = document.getElementById('success-alert') as HTMLDivElement;
  const errorAlert = document.getElementById('error-alert') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Reset alerts
      successAlert.classList.add('d-none');
      successAlert.innerHTML = '';
      errorAlert.classList.add('d-none');
      errorAlert.textContent = '';
      
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      const email = (document.getElementById('email') as HTMLInputElement).value;

      try {
        const response = await fetch('/api/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });

        const data = await response.json();

        if (response.ok) {
          let msg = data.message;
          
          successAlert.innerHTML = msg;
          successAlert.classList.remove('d-none');
          form.reset();
        } else {
          errorAlert.textContent = data.error || 'Failed to send reset link.';
          errorAlert.classList.remove('d-none');
        }
      } catch (err) {
        errorAlert.textContent = 'An unexpected error occurred. Please try again.';
        errorAlert.classList.remove('d-none');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Reset Link';
      }
    });
  }
</script>

<style>
  .auth-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem 1.5rem;
    background-color: var(--color-bg);
  }

  .auth-card {
    width: 100%;
    max-width: 440px;
    padding: 2.5rem;
  }

  .auth-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .auth-header h1 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .auth-header p {
    color: var(--color-text-muted);
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-main);
  }

  .form-group input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.2s;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .alert {
    padding: 1rem;
    border-radius: var(--border-radius-md);
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .alert-success {
    background-color: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .alert-danger {
    background-color: #fef2f2;
    color: #991b1b;
    border: 1px solid #fca5a5;
  }

  .d-none {
    display: none;
  }

  .auth-footer {
    text-align: center;
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .w-full {
    width: 100%;
  }

  .text-primary {
    color: var(--color-primary);
    text-decoration: none;
  }

  .text-primary:hover {
    text-decoration: underline;
  }
</style>
