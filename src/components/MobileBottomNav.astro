---
const { userType, activePath = "" } = Astro.props;

// Current path for active check
const currentPath = activePath || (typeof Astro !== 'undefined' ? Astro.url.pathname : "");

// SVG icons map
const svgIcons: Record<string, string> = {
  home: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>`,
  search: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>`,
  briefcase: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>`,
  file: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>`,
  users: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
  building: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>`,
  settings: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>`
};

// Build role-specific mobile navigation options strictly for authenticated users
let navItems: { name: string; path: string; icon: string }[] = [];

if (userType === "employer") {
  // Employer Mobile Navigation Bar Options:
  // 1: Home (Overview / Dashboard)
  // 2: My Jobs
  // 3: Applications
  // 4: Setting
  navItems = [
    { name: "Home", path: "/employer", icon: "home" },
    { name: "My Jobs", path: "/employer/jobs", icon: "briefcase" },
    { name: "Applications", path: "/employer/applications", icon: "users" },
    { name: "Setting", path: "/employer/settings", icon: "settings" }
  ];
} else if (userType === "admin" || userType === "superadmin" || userType === "masteradmin") {
  const prefix = userType === "masteradmin" ? "/masteradmin" : userType === "superadmin" ? "/superadmin" : "/admin";
  navItems = [
    { name: "Home", path: prefix, icon: "home" },
    { name: "Users", path: `${prefix}/users`, icon: "users" },
    { name: "Employers", path: `${prefix}/employers`, icon: "building" },
    { name: "User Settings", path: `${prefix}/settings`, icon: "settings" }
  ];
} else if (userType === "employee") {
  // Candidate Mobile Navigation Bar Options:
  // 1: Home
  // 2: Find Jobs
  // 3: My Application
  // 4: Setting
  navItems = [
    { name: "Home", path: "/dashboard", icon: "home" },
    { name: "Find Jobs", path: "/jobs", icon: "search" },
    { name: "My Application", path: "/applications", icon: "file" },
    { name: "Setting", path: "/settings", icon: "settings" }
  ];
}

// Function to calculate active state
function checkIsActive(itemPath: string): boolean {
  if (itemPath === "/employer" || itemPath === "/dashboard" || itemPath === "/admin" || itemPath === "/superadmin" || itemPath === "/masteradmin") {
    return currentPath === itemPath || currentPath === `${itemPath}/`;
  }
  return currentPath.startsWith(itemPath);
}
---

{
  userType && navItems.length > 0 && (
    <nav class="mobile-bottom-nav" aria-label="Mobile Navigation">
      {navItems.map((item) => {
        const isActive = checkIsActive(item.path);
        return (
          <a href={item.path} class={isActive ? "nav-item active" : "nav-item"}>
            <span class="icon" set:html={svgIcons[item.icon] || svgIcons["home"]} />
            <span class="label">{item.name}</span>
          </a>
        );
      })}
    </nav>
  )
}

<style>
  /* Hidden on Desktop View (769px and above) */
  .mobile-bottom-nav {
    display: none !important;
  }

  /* Display ONLY on Mobile View (768px and below) for Authenticated Users */
  @media (max-width: 768px) {
    .mobile-bottom-nav {
      display: flex !important;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 64px;
      background: #0d0e16; /* Solid dark background by default for dark mode */
      background: rgba(13, 14, 21, 0.96);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      z-index: 9999;
      align-items: center;
      justify-content: space-around;
      padding: 0 0.5rem;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.45);
      box-sizing: border-box;
    }

    :global([data-theme="light"]) .mobile-bottom-nav {
      background: #ffffff !important;
      background: rgba(255, 255, 255, 0.97) !important;
      border-top-color: #e2e8f0 !important;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08) !important;
    }

    .nav-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      text-decoration: none;
      color: #94a3b8;
      font-size: 0.72rem;
      font-weight: 500;
      padding: 6px 0;
      border-radius: var(--border-radius-md, 8px);
      transition: color 0.15s ease, transform 0.15s ease;
    }

    :global([data-theme="light"]) .nav-item {
      color: #64748b;
    }

    .nav-item .icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      transition: transform 0.15s ease;
    }

    .nav-item:active {
      transform: scale(0.93);
    }

    .nav-item.active {
      color: var(--color-primary, #a78bfa) !important;
      font-weight: 700;
    }

    :global([data-theme="light"]) .nav-item.active {
      color: var(--color-primary, #7c3aed) !important;
    }

    .nav-item.active .icon {
      transform: translateY(-2px);
    }
  }
</style>
