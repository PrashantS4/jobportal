---
const payload = Astro.locals.user as any;
const logoHomePath = 
  payload?.userType === "employer" ? "/employer" :
  payload?.userType === "admin" ? "/admin" :
  payload?.userType === "superadmin" ? "/superadmin" :
  payload?.userType === "masteradmin" ? "/masteradmin" :
  payload?.userType === "employee" ? "/dashboard" : "/";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="logo">
        <a href={logoHomePath} style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: inherit;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
          <span class="logo-text">RecruitNest</span>
        </a>
      </div>
      <p class="brand-desc">
        Connecting top-tier talent with world-class opportunities. Build your future with the most intelligent job matching platform.
      </p>
      <div class="social-links">
        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Twitter"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg></a>
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg></a>
        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a>
      </div>
    </div>
    
    <div class="footer-links">
      <h4>Candidate Features</h4>
      <ul>
        <li><a href="/jobs">Browse All Jobs</a></li>
        <li><a href="/jobs">AI Match Scoring</a></li>
        <li><a href="/applications">Application Tracker</a></li>
        <li><a href="/saved">Saved Bookmarks</a></li>
        <li><a href="/settings">Candidate Profile</a></li>
      </ul>
    </div>

    <div class="footer-links">
      <h4>Employer Features</h4>
      <ul>
        <li><a href="/employer/post-job">Post Job Opening</a></li>
        <li><a href="/employer/screening">AI Vector Screening</a></li>
        <li><a href="/employer/post-job">Stage Journey Builder</a></li>
        <li><a href="/employer">Employer Dashboard</a></li>
        <li><a href="/pricing">Subscription Pricing</a></li>
      </ul>
    </div>

    <div class="footer-newsletter">
      <h4>Stay Updated</h4>
      <p>Subscribe to our newsletter for the latest job market trends.</p>
      <form class="newsletter-form" onsubmit="event.preventDefault(); window.showToast('Subscribed to newsletter successfully!', 'success');">
        <input type="email" placeholder="Enter your email" required />
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </form>
    </div>
  </div>
  
  <div class="footer-bottom container">
    <p>&copy; {new Date().getFullYear()} RecruitNest. All rights reserved.</p>
    <div class="legal-links">
      <a href="/privacy">Privacy Policy</a>
      <a href="/privacy#user-rights">Terms of Service</a>
      <a href="/privacy#cookies">Cookie Policy</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-top: 4rem;
    margin-top: 4rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-brand .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .logo-text {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
  }

  .brand-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 320px;
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-text-muted);
    transition: all 0.2s;
  }

  .social-links a:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .footer-links h4,
  .footer-newsletter h4 {
    font-size: 1.125rem;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
  }

  .footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  .footer-newsletter p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .newsletter-form input {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    background-color: var(--color-bg);
    color: var(--color-text-main);
    font-family: inherit;
    outline: none;
  }

  .newsletter-form input:focus {
    border-color: var(--color-primary);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .legal-links {
    display: flex;
    gap: 1.5rem;
  }

  .legal-links a {
    color: inherit;
    text-decoration: none;
  }

  .legal-links a:hover {
    color: var(--color-primary);
  }

  @media (max-width: 968px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      padding-top: 2.5rem;
      margin-top: 2.5rem;
    }
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1.25rem;
      margin-bottom: 2rem;
    }
    .footer-brand {
      grid-column: span 2;
    }
    .footer-newsletter {
      grid-column: span 2;
    }
    .brand-desc {
      max-width: 100%;
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }
    .footer-links h4,
    .footer-newsletter h4 {
      font-size: 0.95rem;
      margin-bottom: 0.75rem;
    }
    .footer-links a {
      font-size: 0.875rem;
    }
    .newsletter-form input {
      padding: 0.65rem 0.875rem;
      font-size: 0.875rem;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
      padding: 1.5rem 1rem;
    }
    .legal-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
      font-size: 0.8rem;
    }
  }
</style>
